{
  "name": "asset-cms-system",
  "version": "1.0.0",
  "description": "Modular asset management CMS with Supabase and Cloudflare Workers",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node src/index.js",
